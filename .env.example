# Copy to .env.local to override. Defaults below match `meta`'s docker-compose
# local setup, and are also the fallbacks compiled into src/api/config.js.
#
# These are read at BUILD time, not run time. A variable added here must also be
# added to .github/workflows/deploy.yml or the deployed bundle ships the
# localhost default.
VITE_AGENT_SERVICE_URL=http://localhost:8080/api/agent/v1
VITE_NAVIGATION_SERVICE_URL=http://localhost:8081/api/navigation/v1
VITE_FLEET_SERVICE_URL=http://localhost:3001/api/fleet/v1
VITE_AUTOMATION_SERVICE_URL=http://localhost:3003/api/automation/v1
VITE_ST_GATEWAY_URL=http://localhost:3002

# Health probe only, and only locally: ai-service has no public origin, so in a
# production build this stays at its localhost default and the app drops it from
# the health strip rather than showing a dot it can never turn green.
VITE_AI_SERVICE_URL=http://localhost:3004

# Clerk development instance publishable key. Public by design — it names the
# instance and authorizes nothing. Required: the app renders a setup message
# without it. The committed dev keypair in meta/dev-keys covers the backend
# services only; minting a browser session needs a real Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
