{
  // Typechecking only: Vite (esbuild) compiles and bundles, tsc never emits.
  // The strictness flags match ts-introspection-client's tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    // Ambient types only for Vite's `import.meta.env` and asset imports. Tests
    // import from "vitest" explicitly (globals are off), so no vitest/globals.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
